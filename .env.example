# Required
POSTGRES_USER=eem
POSTGRES_PASSWORD=
POSTGRES_DB=eem
REDIS_PASSWORD=
# signs environment access tokens; at least 32 bytes, e.g. openssl rand -hex 32
PROXY_SECRET=

# Docker socket group for eem and the worker: 0 on Docker Desktop, the docker
# group on Linux (getent group docker | cut -d: -f3)
DOCKER_GID=0

# GitHub sign-in (optional)
PUBLIC_URL=http://localhost:8080
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# comma-separated logins allowed to sign up; empty allows anyone
GITHUB_ALLOWED_USERS=

# Policy (optional)
# false makes callers use stored templates only
INLINE_TEMPLATES=true
# scopes this stack's containers so stacks sharing a Docker host ignore each
# other; defaults to the compose project name
EEM_INSTANCE=
DOCKER_PIDS_LIMIT=1024
# true enforces disk_gb; needs overlay2 on xfs mounted with pquota
DOCKER_DISK_QUOTA=false

# Proxy (optional)
PROXY_DOMAIN=env.localhost
PROXY_PUBLIC_PORT=8000
PROXY_CONTAINER=eem-proxy
# the proxy's fixed address on the edge network shared with Postgres
EDGE_SUBNET=10.231.0.0/24
PROXY_IP=10.231.0.10

# Host port for the API and dashboard (optional). Postgres and Redis publish
# no host ports.
EEM_PORT=8080

# text or json
LOG_FORMAT=text

# Tests run against compose.test.yaml. Leave the URLs unset to use it; set the
# ports if 55432 or 56379 are taken.
TEST_POSTGRES_PORT=55432
TEST_REDIS_PORT=56379
TEST_DOCKER=1
